# direnv configuration for streetlights-demo
# Activate the uv venv if it exists
layout python-venv .venv

# Load PG service name from manifest (if it exists)
# This lets you run: psql "service=$PGSERVICE connect_timeout=10"
# instead of remembering the instance name.
#
# The $snowflake-postgres skill manages ~/.pg_service.conf + ~/.pgpass
# with the actual host/user/password — we only export the service name here.
MANIFEST=".streetlights-demo/manifest.toml"
if [ -f "$MANIFEST" ]; then
  # Extract pg_instance from TOML (simple grep — no toml parser needed)
  PG_INSTANCE=$(grep '^pg_instance' "$MANIFEST" | cut -d'"' -f2)
  if [ -n "$PG_INSTANCE" ]; then
    export PGSERVICE="$PG_INSTANCE"
    export PGDATABASE="streetlights"
  fi
fi
