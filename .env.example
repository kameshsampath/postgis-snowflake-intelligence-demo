# ============================================================
# PostGIS Data Intelligence Demo — Environment Variables
# ============================================================
# Copy to .env and fill in values. The setup step ($streetlights-demo setup)
# can write this file for you automatically.
#
# FORBIDDEN: Never put passwords, tokens, or secrets here.
# Credentials are managed via ~/.pg_service.conf + ~/.pgpass (Postgres)
# and CLI profiles / OAuth (Snowflake `snow`, Databricks `databricks`).
# ============================================================

# -- Platform selection --
# Which platform(s) to run: snowflake | databricks | both
PLATFORM=both

# -- PostgreSQL / Lakebase Connection --
# Service name from ~/.pg_service.conf. On Databricks, `mise run lb-cred` creates
# the [lakebase-demo] service (with passfile=~/.pgpass) for you. The Lakebase OAuth
# token stored there expires after 1h; refresh with `mise run lb-cred` again.
PGSERVICE=lakebase-demo
# Default database for psql connections (informational; the service file wins)
PGDATABASE=streetlights

# -- Snowflake Connection --
# Named connection from ~/.snowflake/connections.toml
SNOWFLAKE_CONNECTION=
# Role used for PG instance creation (typically ACCOUNTADMIN)
SNOWFLAKE_ROLE=

# -- Databricks Connection --
# Workspace URL, e.g. https://adb-1234567890123456.7.azuredatabricks.net
DATABRICKS_HOST=
# Databricks CLI profile name (browser login `databricks auth login` creates DEFAULT)
DATABRICKS_PROFILE=DEFAULT
# DATABRICKS_TOKEN is an alternative to a profile — never commit a real token
# DATABRICKS_TOKEN=
# Lakebase project / branch / endpoint / database (see docs/databricks-guide.md step 2).
# create-project auto-creates branch "production" and endpoint "primary".
LAKEBASE_PROJECT=
LAKEBASE_BRANCH=production
ENDPOINT=primary
# The Postgres database inside the branch; comes from the generate-database-credential
# JSON ".database" (usually databricks_postgres). `mise run lb-cred` reads it automatically.
LAKEBASE_DATABASE=databricks_postgres
# DAB variable override for the bundle (applies to deploy AND run).
# LOWERCASE literal: Unity Catalog lowercases all object names, so do NOT write
# BUNDLE_VAR_prefix=$DEMO_PREFIX here — use e.g. pgdemo (matches lowercased DEMO_PREFIX).
BUNDLE_VAR_prefix=pgdemo

# -- Demo Configuration --
# Resource prefix (objects are named ${PREFIX}_STREETLIGHTS_*)
DEMO_PREFIX=
# Warehouse name (existing or will be created)
DEMO_WAREHOUSE=
# City for synthetic data generation
DEMO_CITY=
DEMO_CENTER_LAT=
DEMO_CENTER_LNG=
