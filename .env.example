# ============================================================
# Streetlights Demo — Environment Variables
# ============================================================
# Copy to .env and fill in values. The setup step ($streetlights-demo setup)
# can write this file for you automatically.
#
# FORBIDDEN: Never put passwords, tokens, or secrets here.
# Credentials are managed via ~/.pg_service.conf + ~/.pgpass
# (handled by the $snowflake-postgres skill).
# ============================================================

# -- PostgreSQL Connection --
# Service name from ~/.pg_service.conf (created by $snowflake-postgres)
PGSERVICE=
# Default database for psql connections
PGDATABASE=streetlights

# -- Snowflake Connection --
# Named connection from ~/.snowflake/connections.toml
SNOWFLAKE_CONNECTION=
# Role used for PG instance creation (typically ACCOUNTADMIN)
SNOWFLAKE_ROLE=

# -- Demo Configuration --
# Resource prefix (all Snowflake objects: ${PREFIX}_STREETLIGHTS_*)
DEMO_PREFIX=
# Warehouse name (existing or will be created)
DEMO_WAREHOUSE=
# City for synthetic data generation
DEMO_CITY=
DEMO_CENTER_LAT=
DEMO_CENTER_LNG=
