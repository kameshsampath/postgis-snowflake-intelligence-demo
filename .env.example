# ============================================================
# PostGIS Data Intelligence Demo — Environment Variables
# ============================================================
# Copy to .env and fill in values. The setup step ($streetlights-demo setup)
# can write this file for you automatically.
#
# FORBIDDEN: Never put passwords, tokens, or secrets here.
# Credentials are managed via ~/.pg_service.conf + ~/.pgpass (Postgres)
# and CLI profiles / OAuth (Snowflake `snow`, Databricks `databricks`).
# ============================================================

# -- Platform selection --
# Which platform(s) to run: snowflake | databricks | both
PLATFORM=both

# -- PostgreSQL / Lakebase Connection --
# Service name from ~/.pg_service.conf (created for your PG instance)
PGSERVICE=
# Default database for psql connections
PGDATABASE=streetlights

# -- Snowflake Connection --
# Named connection from ~/.snowflake/connections.toml
SNOWFLAKE_CONNECTION=
# Role used for PG instance creation (typically ACCOUNTADMIN)
SNOWFLAKE_ROLE=

# -- Databricks Connection --
# Workspace URL, e.g. https://adb-1234567890123456.7.azuredatabricks.net
DATABRICKS_HOST=
# Databricks CLI profile name from ~/.databrickscfg (recommended auth method)
DATABRICKS_PROFILE=
# DATABRICKS_TOKEN is an alternative to a profile — never commit a real token
# DATABRICKS_TOKEN=
# Lakebase project / branch / database (fill in after creating them, see docs/databricks-guide.md)
LAKEBASE_PROJECT=
LAKEBASE_BRANCH=main
LAKEBASE_DATABASE=streetlights

# -- Demo Configuration --
# Resource prefix (objects are named ${PREFIX}_STREETLIGHTS_*)
DEMO_PREFIX=
# Warehouse name (existing or will be created)
DEMO_WAREHOUSE=
# City for synthetic data generation
DEMO_CITY=
DEMO_CENTER_LAT=
DEMO_CENTER_LNG=
