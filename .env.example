# PostGIS Data Intelligence Demo - Environment Variables

# ==========================================================================
# Databricks Configuration
# ==========================================================================

# Databricks Workspace
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com

# Databricks CLI Profile (for authentication)
DATABRICKS_PROFILE=default

# Databricks Token (alternative to profile - do not commit actual tokens)
# DATABRICKS_TOKEN=yyour-personal-access-token

# ==========================================================================
# Snowflake Configuration (existing)
# ==========================================================================

# Snowflake connection name (must match your snow CLI configuration)
# For example: from `snow connection list`
# SNOWFLAKE_CONNECTION=my_connection

# ==========================================================================
# Application Configuration
# ==========================================================================

# Demo resource prefix (e.g., your name initials: KAMESHS)
DEMO_PREFIX=YOUR_PREFIX

# City for demo data generation
CITY=Portland
LATITUDE=45.5152
LONGITUDE=-122.6784

# Number of street lights to generate
STREET_LIGHT_COUNT=500

# ==========================================================================
# PostgreSQL Configuration
# ==========================================================================

# PostgreSQL service name (must match your .pg_service or psql service)
# PG_SERVICE=my_pg_service

# ==========================================================================
# Notes:
# ==========================================================================
# 1. Copy this file to .env and fill in your actual values
# 2. Add .env to .gitignore to prevent committing sensitive data
# 3. For Databricks authentication, use CLI profiles (recommended)
#    rather than storing tokens in this file
# 4. Snowflake and PostgreSQL configurations can use existing
#    CLI configurations (snow, psql)
# 5. The .env file is loaded by some demo tools but most
#    configurations are managed through .streetlights-demo/manifest.toml
