#
# Personal mise overrides. Copy to `.mise.local.toml` (gitignored) and tweak freely:
#
#     cp .mise.local.toml.example .mise.local.toml
#
# `.mise.toml` stays the committed, safe base template; mise loads
# `.mise.local.toml` automatically on top of it. `.env` is loaded via `_.file`
# in the base config, so secrets/connection values belong in `.env`
# (also gitignored), never here.

# [tools]
# extra personal tools, e.g.
# jq = "latest"

# [env]
# Demo/platform overrides (these used to live in .mise.toml; keep the base
# template clean and put them here or in .env):
# PLATFORM = "databricks"            # snowflake | databricks | both; tooling fails fast if unset
# DEMO_PREFIX = "PGDEMO"
# DEMO_CITY = "Portland"
# LATITUDE = "45.5152"
# LONGITUDE = "-122.6784"
# STREET_LIGHT_COUNT = "5000"
#
# Other local-only env tweaks:
# UV_PROJECT_ENVIRONMENT = ".venv"   # NOTE: this is a venv PATH, not a boolean
# EDITOR = "code"
